extern fn zen_bcrypt_hash(
  string password,
  int cost
) string

extern fn zen_bcrypt_verify(
  string password,
  string hash
) bool


struct Bcrypt {
  hash(string password, int cost) string {
    if (cost < 4 || cost > 31) {
      return ""
    }

    return zen_bcrypt_hash(password, cost)
  }

  verify(string password, string hash) bool {
    return zen_bcrypt_verify(password, hash)
  }
}


export(Bcrypt)
